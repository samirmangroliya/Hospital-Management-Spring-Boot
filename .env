# ============================================================
# Hospital Management System - LOCAL
# Spring Boot services run on the host machine.
# Docker infrastructure is exposed on localhost.
# ============================================================

# Service ports
API_GATEWAY_PORT=8080
PATIENT_SERVICE_PORT=8081
DOCTOR_SERVICE_PORT=8082
APPOINTMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
EUREKA_PORT=8761
POSTGRES_PORT=5432

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgres
PATIENT_DB=patient_db
DOCTOR_DB=doctor_db
APPOINTMENT_DB=appointment_db
PATIENT_DB_URL=jdbc:postgresql://postgres:5432/patient_db
DOCTOR_DB_URL=jdbc:postgresql://postgres:5432/doctor_db
APPOINTMENT_DB_URL=jdbc:postgresql://postgres:5432/appointment_db

# Eureka
EUREKA_URL=http://eureka-server:8761/eureka/

# Kafka
KAFKA_BOOTSTRAP_SERVER=kafka:9092

# OpenTelemetry
OTEL_ENDPOINT=http://jaeger:4317
OTEL_METRICS_ENDPOINT=http://otel-collector:4318

# MongoDB
MONGO_URI=mongodb://notification-db:27017/notification_db